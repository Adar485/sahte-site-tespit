# MySQL connection settings for Sahte Site Avcıları.
# Each developer copies this file to .env and enters their own values.
# .env is not tracked by Git; never commit real credentials. Keep this template in sync
# when settings are added.
#
# DB_HOST and DB_PORT below are EXAMPLE local defaults. They must match the
# "Hostname" and "Port" of your MySQL Workbench connection
# (Workbench > Database > Manage Connections).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sahte_site_tespit
DB_USER=root
DB_PASSWORD=__ENTER_YOUR_PASSWORD__

# Optional (defaults shown)
# DB_CONNECT_TIMEOUT=5
# DB_ECHO=false

# Optional reference domain list for spelling-similarity comparison (see README).
# REFERENCE_DOMAINS_FILE=reference_domains.json

# Page capture with headless Chromium (defaults shown; see README for all fields).
# CAPTURE_ENABLED=true
# CAPTURE_STORAGE_DIR=var/captures
# CAPTURE_NAVIGATION_TIMEOUT_S=20
# CAPTURE_TOTAL_TIMEOUT_S=45
# CAPTURE_STORAGE_MAX_MB=1024

# Browser origins allowed to call the API (comma-separated). Default: the Vite dev server.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Offline visual embedding extraction (model folder relative to backend).
# VISUAL_ENABLED=true
# VISUAL_MODEL_DIR=../models/dinov2-small
