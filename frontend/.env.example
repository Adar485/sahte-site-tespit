# Copy to .env.local (ignored by Git) to override. Vite only exposes variables
# prefixed with VITE_ to the browser, so never put secrets here; MySQL settings
# belong in backend/.env only.

# FastAPI backend address (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# live (default): use the backend. demo: local sample data only, no backend calls.
VITE_ANALYSIS_MODE=live
